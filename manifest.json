{
  "manifest_version": 3,
  "name": "YouTube Focus Filter",
  "version": "0.1.0",
  "description": "Hides YouTube videos that are not software engineering, tech, or educational, using the OpenAI Decisions API.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YouTube Focus Filter settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
